# Nom de l organ dans SpinalCom ; sert aussi de nom de repli au client BACnet.
ORGAN_NAME="name"
USER_ID="XXX"
PASSWORD="*******"
PROTOCOL="http"
HOST="127.0.0.1"
PORT="8080"


ORGAN_FOLDER_PATH="/__users__/admin/organs" # Chemin dans le Hub ou l organ sera cree.

BACNET_PRIORITY="16"


# Avec 1/true, efface les donnees de l organ si leur format est incompatible (operation destructive).
CLEAR_ORGAN_IF_NOT_COMPATIBLE="1"


# Port du service BACnet local ; valeur par defaut : 47810.
BACNET_SERVICE_PORT="47810" # default 47810


# Avec 1/true, lance un service BACnet local ; sinon, se connecte au service configure.
LAUNCH_OWN_BACNET_SERVICE="1"


# Avec 1/true, demande au service BACnet (local) d'activer ses logs.
LOG_BACNET_SERVICE="0" #log bacnet service if 1 or true


# Avec 1/true, ignore la creation initiale des endpoints dans le graphe.
SKIP_ENDPOINTS_INITIALIZATION="0"

# Avec 1/true, active le calcul et l'affichage des indicateurs des devices.
# Toute autre valeur (ou variable absente) desactive le calcul et ces logs.
ADD_INDICATORS="0"